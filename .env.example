# Copy to .env.local and fill in. Server-side only: never prefix these with NEXT_PUBLIC_.

# Proposales API (https://api.proposales.com), Bearer token
PROPOSALES_API_KEY=

# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Optional: OpenAI model id, defaults to gpt-5-mini
# OPENAI_MODEL=

# Optional: "mock" returns fake suggestions without calling OpenAI (for UI work); defaults to "live"
# RECOMMENDATIONS_MODE=mock

# Postgres connection string for feedback storage (Neon via the Vercel Marketplace).
# Optional locally: without it, feedback is kept in memory until the dev server restarts.
DATABASE_URL=
